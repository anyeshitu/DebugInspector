<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.allynav.debug.inspector.ui">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <activity
            android:name=".InspectorActivity"
            android:exported="false"
            android:theme="@style/InspectorTheme" />
        <activity
            android:name=".InspectorDetailActivity"
            android:exported="false"
            android:theme="@style/InspectorTheme" />
        <activity
            android:name=".DatabaseTablesActivity"
            android:exported="false"
            android:theme="@style/InspectorTheme" />
        <activity
            android:name=".DatabaseRowsActivity"
            android:exported="false"
            android:theme="@style/InspectorTheme" />
        <provider
            android:name=".InspectorFileProvider"
            android:authorities="${applicationId}.debuginspector.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
